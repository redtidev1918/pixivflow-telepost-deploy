#!/bin/sh
# deploy 引导器：零依赖启动 deploy.py。
# 任何 Linux/macOS 都有 sh；没有 python3 时自动安装，然后转交 deploy.py。
# 用法：./deploy [子命令...]  或  sh deploy [子命令...]
set -eu

SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if command -v python3 >/dev/null 2>&1; then
  exec python3 "$SELF_DIR/deploy.py" "$@"
fi

echo "› 未检测到 python3，尝试自动安装…"

if command -v apt-get >/dev/null 2>&1; then
  sudo apt-get update -qq && sudo apt-get install -y -qq python3
elif command -v dnf >/dev/null 2>&1; then
  sudo dnf install -y python3
elif command -v yum >/dev/null 2>&1; then
  sudo yum install -y python3
elif command -v apk >/dev/null 2>&1; then
  apk add --no-cache python3
elif command -v pacman >/dev/null 2>&1; then
  sudo pacman -S --noconfirm python3
elif command -v brew >/dev/null 2>&1; then
  brew install python3
else
  echo "✗ 无法识别包管理器，请手动安装 Python 3 后重试："
  echo "  https://www.python.org/downloads/"
  exit 1
fi

command -v python3 >/dev/null 2>&1 || {
  echo "✗ python3 安装后仍未找到，请检查 PATH"
  exit 1
}
echo "✓ python3 就绪"
exec python3 "$SELF_DIR/deploy.py" "$@"
