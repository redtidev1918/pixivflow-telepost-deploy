# 敏感信息（Bot Token、Pixiv Token、订阅地址等）
.env
.env.*
!.env.example

# 本机构建的 deploy 二进制（从 GitHub Releases 下载或 go build 产物）
/deploy
/deploy.exe
/deploy-*

# 运行时数据（数据库、下载文件、日志、代理缓存）
data/
proxy-data/
*.log
*.upload

# TelePost Fly 本地策略与凭据；只提交 *.example.json 模板
fly/config/*.json
!fly/config/*.example.json
fly/scripts/*.env
fly/data/

# PixivFlow 运行时配置（含 refresh token，从 .env 注入）
pixivflow/config/standalone.config.json
pixivflow/config/config.json

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage*
htmlcov/
.venv/
venv/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
telesubmit.fly.toml
