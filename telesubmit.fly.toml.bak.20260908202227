app = "telesubmit-multi-bot"
primary_region = "iad"

[build]
  dockerfile = "docker/combined.Dockerfile"

[build.args]
  TELEPOST_IMAGE = "ghcr.io/redtidev1918/telepost:2.13.0"
  PIXIVFLOW_VERSION = "2.11.0"

[env]
  PYTHONUNBUFFERED = "1"
  PYTHONDONTWRITEBYTECODE = "1"
  TZ = "Asia/Shanghai"
  RUN_MODE = "WEBHOOK"
  WEBHOOK_URL = "https://telesubmit-multi-bot.fly.dev"
  SEARCH_ANALYZER = "simple"
  SEARCH_ENABLED = "false"
  DB_CACHE_KB = "1024"
  # Autosleep external 模式：run.py 拉起 pixivflow，但它不跑内部 cron、冷启动不补跑，
  # 只提供受认证的 Slot 触发端点（8090）。外部时钟（Cloudflare）POST 公网 /internal/*
  # （run.py 反代到 8090）唤醒机器并同步跑 morning/evening Slot。
  # 独立的 256 always-on pixivflow app 在迁移验证后停用，避免双调度。
  PIXIVFLOW_ENABLED = "true"
  PIXIVFLOW_CONFIG = "/app/data/pixivflow/config.json"
  TELEPOST_API_BASE_URL = "http://127.0.0.1:8080"
  PIXIVFLOW_TRIGGER_PORT = "8090"
  # trigger 服务的 Bearer token 也可由 config 提供；这里走 secret SCHEDULER_TRIGGER_TOKEN。
  PIXIV_DB_CACHE_KB = "4096"
  NODE_OPTIONS = "--max-old-space-size=96 --expose-gc"
  MALLOC_ARENA_MAX = "2"
  # 审核群多页预览：每批最多 10 张组成相册；1=后续批次回复上一批
  REVIEW_PREVIEW_THREAD = "1"
  REVIEW_PREVIEW_INTERVAL_SECONDS = "0.75"
  REVIEW_PREVIEW_TIMEOUT_SECONDS = "120"
  REVIEW_ALBUM_SIZE = "5"
  PENDING_REVIEW_RETENTION_DAYS = "1"
  PENDING_REVIEW_CLEANUP_BATCH_SIZE = "20"
  REVIEW_RETENTION_DAYS = "30"

[mounts]
  source = "data"
  destination = "/app/data"

[http_service]
  internal_port = 8080
  # force_https=false：让独立 PixivFlow 经 Flycast 私网 HTTP（80→8080）直连唤醒本机，
  # 否则会被 301 跳 HTTPS 导致投递失败。Telegram webhook 仍走公网 HTTPS，不受影响。
  force_https = false
  # Autosleep：平时停机省 RAM；webhook / 用户投稿 / PixivFlow Flycast 投递都能唤醒。
  auto_stop_machines = "stop"
  auto_start_machines = true
  min_machines_running = 0

  [[http_service.checks]]
    # 512 MiB 机器在 PixivFlow 大批量下载/投递瞬间响应会变慢（仍在工作），
    # 5s/30s 的组合太苛刻会把正常负载误判为 critical。放宽到 30s 超时 + 60s 间隔。
    grace_period = "120s"
    interval = "60s"
    method = "GET"
    timeout = "30s"
    path = "/health"

[vm]
  cpu_kind = "shared"
  cpus = 1
  memory_mb = 512
