# ============================================================================
# PixivFlow + TelePost 部署套件 — 环境变量配置模板
# ============================================================================
# 复制本文件为 .env（已被 .gitignore 排除，不会入库），按需修改。
# 所有配置项都有默认值，最少只需设置 BOT1_TOKEN 和 BOT1_CHANNEL_ID。
# ============================================================================

# ============================================================================
# TelePost — Telegram Bot 配置
# ============================================================================
# 单 bot：只需 BOT1_TOKEN 和 BOT1_CHANNEL_ID
# 多 bot：依次设置 BOT2_TOKEN、BOT2_CHANNEL_ID……（最多 9 个）

# Bot 1 Token（从 @BotFather 获取）
BOT1_TOKEN=

# Bot 1 频道 ID（-100xxxxxxxxxx 或 @channel_username）
BOT1_CHANNEL_ID=

# Bot 1 所有者 Telegram User ID（用于接收通知和管理命令）
BOT1_OWNER_ID=

# --- 多 bot 可选配置（BOT2, BOT3...）---
# BOT2_TOKEN=
# BOT2_CHANNEL_ID=
# BOT2_OWNER_ID=

# ============================================================================
# TelePost — 运行模式
# ============================================================================
# AUTO（默认）：有公网 HTTPS Webhook 地址时用 Webhook，否则回退 Polling
# POLLING：TelePost 主动轮询 Telegram（适合无公网 IP 的机器）
# WEBHOOK：Telegram 推送更新到服务器（需公网 HTTPS 域名）
RUN_MODE=AUTO

# Webhook 外部地址（RUN_MODE=AUTO/WEBHOOK 时使用）
# 必须是 HTTPS 且公网可达，例如 https://your-app.fly.dev
# 多 bot 时，TelePost 自动为每个 bot 生成 /webhook/botN 回调路径
WEBHOOK_URL=

# TelePost 内部端口（默认 8080，多 bot 时路由进程占此端口）
TELEPOST_PORT=8080

# ============================================================================
# TelePost — Bot 功能配置
# ============================================================================

# Bot 模式：MEDIA（仅媒体）| DOCUMENT（仅文档）| MIXED（混合，默认）
BOT1_BOT_MODE=MIXED

# 审核开关（设为 true 则投稿先进入审核群，管理员通过后才发布）
BOT1_API_REVIEW_REQUIRED=false
BOT1_CHAT_REVIEW_REQUIRED=false
# 审核群 ID（任一审核开关为 true 时必填）
# BOT1_REVIEW_CHAT_ID=-1001234567890

# 每小时每用户投稿上限（0 为不限制）
BOT1_SUBMIT_LIMIT_PER_HOUR=10

# 是否显示投稿人信息
BOT1_SHOW_SUBMITTER=true

# ============================================================================
# TelePost — 搜索配置
# ============================================================================
# 分词器：simple（省内存，适合 512MB 以下）| jieba（中文效果好，需 ~20MB）
SEARCH_ANALYZER=simple
# 是否启用搜索
SEARCH_ENABLED=false

# ============================================================================
# PixivFlow — 配置（可选，不设置则不启动 PixivFlow）
# ============================================================================

# PixivFlow 是否启用
PIXIVFLOW_ENABLED=false

# Pixiv Refresh Token（通过 pixivflow login 获取）
PIXIV_REFRESH_TOKEN=

# PixivFlow 配置路径（自动生成，一般无需修改）
PIXIVFLOW_CONFIG=/app/data/pixivflow/config.json

# Pixiv 客户端凭证（使用默认值即可）
# PIXIV_CLIENT_ID=MOBrBDS8blbauoSck0ZfDbtuzpyT
# PIXIV_CLIENT_SECRET=lsACyCD94FhDUtGTXi3QzcFE2uU1hqtDaKeqrdwj

# 下载目录
PIXIV_DOWNLOAD_DIR=/app/downloads

# 日志级别
PIXIV_LOG_LEVEL=info

# SQLite 页缓存（KiB）；512 MiB 环境建议 4096
PIXIV_DB_CACHE_KB=4096

# ============================================================================
# 代理配置（可选，国内服务器建议启用）
# ============================================================================
# 是否启用 Mihomo 代理容器
PROXY_ENABLED=false

# 代理地址（Docker 网络内，通过容器名 proxy 访问）
PROXY_HTTP=http://proxy:7890
PROXY_SOCKS5=socks5://proxy:7890

# PixivFlow 使用的代理（留空则不使用代理）
PIXIVFLOW_PROXY=

# TelePost 使用的代理（留空则不使用代理）
TELEPOST_PROXY=

# Mihomo 订阅地址（PROXY_ENABLED=true 时必填）
# SUB_URL=https://your-airport.example/subscription?url=xxxxx

# ============================================================================
# 时区
# ============================================================================
TZ=Asia/Shanghai