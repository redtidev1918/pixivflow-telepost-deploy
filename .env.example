# 镜像版本。默认优先拉取预构建镜像，必要时可 `docker compose build stack`。
STACK_IMAGE=ghcr.io/redtidev1918/pixivflow-telepost-deploy:latest
TELEPOST_IMAGE=ghcr.io/redtidev1918/telepost:2.10.31
PIXIVFLOW_VERSION=2.10.26

# AUTO + 空 WEBHOOK_URL = Polling，无公网机器无需额外配置。
# 有公网域名时设置 WEBHOOK_DOMAIN 和 WEBHOOK_URL，并启动 webhook profile。
RUN_MODE=AUTO
WEBHOOK_DOMAIN=
WEBHOOK_URL=
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
TZ=Asia/Shanghai

# 审核群多页预览：图片每批最多 10 张组成相册；1=后续批次回复上一批（默认）。
REVIEW_PREVIEW_THREAD=1
REVIEW_PREVIEW_INTERVAL_SECONDS=0.75
REVIEW_PREVIEW_TIMEOUT_SECONDS=120
# 审核群相册每组媒体数（Telegram 上限 10；512MiB 小内存机器建议 4~5）
REVIEW_ALBUM_SIZE=5
# 待审核超过 1 天自动过期并删除审核群消息（Telegram Bot API 删除窗口为 48 小时）。
PENDING_REVIEW_RETENTION_DAYS=1
PENDING_REVIEW_CLEANUP_BATCH_SIZE=20
# 已发布/拒绝/失败/过期的轻量数据库记录继续保留 30 天。
REVIEW_RETENTION_DAYS=30

# Bot 1（必填）
BOT1_TOKEN=
BOT1_CHANNEL_ID=
BOT1_OWNER_ID=
BOT1_BOT_MODE=MIXED
BOT1_API_REVIEW_REQUIRED=true
BOT1_CHAT_REVIEW_REQUIRED=false
BOT1_REVIEW_CHAT_ID=
BOT1_WEBHOOK_SECRET_TOKEN=

# Bot 2（不用时全部留空）
BOT2_TOKEN=
BOT2_CHANNEL_ID=
BOT2_OWNER_ID=
BOT2_BOT_MODE=MIXED
BOT2_API_REVIEW_REQUIRED=true
BOT2_CHAT_REVIEW_REQUIRED=false
BOT2_REVIEW_CHAT_ID=
BOT2_WEBHOOK_SECRET_TOKEN=

# PixivFlow。投稿 token 由对应 Bot 的 /gen_token 生成，只供 PixivFlow 使用。
PIXIVFLOW_ENABLED=true
PIXIV_REFRESH_TOKEN=
TELEPOST_BOT1_SUBMIT_TOKEN=
TELEPOST_BOT2_SUBMIT_TOKEN=

# 512 MiB 低内存档
MEMORY_LIMIT=512m
CPU_LIMIT=1.0
NODE_OPTIONS=--max-old-space-size=96 --expose-gc
MALLOC_ARENA_MAX=2
SEARCH_ENABLED=false
SEARCH_ANALYZER=simple
DB_CACHE_KB=1024
PIXIV_DB_CACHE_KB=4096
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

# 国内网络可选代理。使用内置 Mihomo 时把两项设为 http://proxy:7890，
# 然后用 `docker compose --profile proxy up -d`。
HTTP_PROXY_URL=
EGRESS_ALL_PROXY=
SUB_URL=
PROXY_PORT=7890
PROXY_CONTROLLER_PORT=9090
PROXY_MEMORY_LIMIT=128m

# 国内机器本地构建时，可指向宿主机已可用的 HTTP 代理。
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
