{
    "logLevel": "info",
    "pixiv": {
        "clientId": "${PIXIV_CLIENT_ID}",
        "clientSecret": "${PIXIV_CLIENT_SECRET}",
        "deviceToken": "${PIXIV_DEVICE_TOKEN}",
        "refreshToken": "${PIXIV_REFRESH_TOKEN}",
        "userAgent": "PixivAndroidApp/5.0.234 (Android 11; Pixel 6)",
        "accountId": "default"
    },
    "network": {
        "timeoutMs": 30000,
        "retries": 3,
        "retryDelay": 2000
    },
    "storage": {
        "databasePath": "./pixivflow.db",
        "downloadDirectory": "./downloads",
        "cacheRetentionDays": 7
    },
    "scheduler": {
        "enabled": false,
        "cron": "0 3 * * *",
        "timezone": "Asia/Shanghai"
    },
    "schedules": [
        {
            "id": "bot1-daily",
            "name": "Bot1 每日 10:00 テーマ甲 非AI插画 + 中文小说 (NSFW)",
            "enabled": true,
            "cron": "0 10 * * *",
            "timezone": "Asia/Shanghai",
            "targetIds": [
                "bot1-illust-topic-a",
                "bot1-novel-topic-a"
            ],
            "timeout": 1800000,
            "maxConsecutiveFailures": 5,
            "failureRetryDelay": 30000
        },
        {
            "id": "bot2-daily",
            "name": "Bot2 每日 10:10 テーマ乙 非AI插画 + 中文小说 (NSFW)",
            "enabled": true,
            "cron": "10 10 * * *",
            "timezone": "Asia/Shanghai",
            "targetIds": [
                "bot2-illust-topic-b",
                "bot2-novel-topic-b"
            ],
            "timeout": 1800000,
            "maxConsecutiveFailures": 5,
            "failureRetryDelay": 30000
        }
    ],
    "schedulerRuntime": {
        "mode": "external",
        "catchUpMissedRuns": false,
        "watchConfig": true,
        "reloadDebounceMs": 500,
        "queueLimit": 2,
        "trigger": {
            "port": 8090,
            "host": "0.0.0.0",
            "graceMinutes": 720
        },
        "exitWhenIdle": true,
        "idleGraceMs": 900000,
        "maxLifetimeMs": 10800000,
        "resourceGovernance": {
            "pixivAccounts": {
                "default": {
                    "maxConcurrency": 1
                }
            }
        }
    },
    "download": {
        "concurrency": 1,
        "requestDelay": 1000,
        "dynamicConcurrency": false,
        "minConcurrency": 1,
        "maxRetries": 3,
        "retryDelay": 3000,
        "timeout": 90000,
        "maxFallbackStages": 3,
        "materializationPolicy": "on-demand"
    },
    "delivery": {
        "targets": {
            "bot1-submit": {
                "type": "httpMultipart",
                "url": "${TELEPOST_API_BASE_URL}/api/bot1/v1/submissions",
                "readinessUrl": "${TELEPOST_API_BASE_URL}/api/bot1/v1/health",
                "refetchOutcomeUrl": "${TELEPOST_API_BASE_URL}/api/bot1/v1/refetch/outcomes",
                "headers": {
                    "Authorization": "Bearer ${TELEPOST_BOT1_SUBMIT_TOKEN}"
                },
                "fileField": "files",
                "previewFileField": "previews",
                "fields": {
                    "tags": "{{workTags}},{{topicTag}}",
                    "title": "{{displayTitle}}",
                    "note": "🖌 作者：{{author}}\n⭐ {{bookmarkCount}} · 👁 {{viewCount}}\n🏷 {{topicTag}} · Pixiv 分级：{{xRestrictLabel}}",
                    "link": "{{link}}",
                    "spoiler": false,
                    "idempotency_key": "{{idempotencyKey}}",
                    "target_id": "{{targetId}}",
                    "work_type": "{{type}}",
                    "pixiv_id": "{{pixivId}}",
                    "source_label": "PixivFlow · {{slotName}}",
                    "source_ref": "{{executionId}}",
                    "scheduled_at": "{{occurrenceAt}}",
                    "refetch_request_id": "{{refetchRequestId}}"
                },
                "maxAttempts": 3,
                "retryDelayMs": 3000,
                "scheduleOutcomeUrl": "${TELEPOST_API_BASE_URL}/api/bot1/v1/schedule/outcomes"
            },
            "bot2-submit": {
                "type": "httpMultipart",
                "url": "${TELEPOST_API_BASE_URL}/api/bot2/v1/submissions",
                "readinessUrl": "${TELEPOST_API_BASE_URL}/api/bot2/v1/health",
                "refetchOutcomeUrl": "${TELEPOST_API_BASE_URL}/api/bot2/v1/refetch/outcomes",
                "headers": {
                    "Authorization": "Bearer ${TELEPOST_BOT2_SUBMIT_TOKEN}"
                },
                "fileField": "files",
                "previewFileField": "previews",
                "fields": {
                    "tags": "{{workTags}},{{topicTag}}",
                    "title": "{{displayTitle}}",
                    "note": "🖌 作者：{{author}}\n⭐ {{bookmarkCount}} · 👁 {{viewCount}}\n🏷 {{topicTag}} · Pixiv 分级：{{xRestrictLabel}}",
                    "link": "{{link}}",
                    "spoiler": false,
                    "idempotency_key": "{{idempotencyKey}}",
                    "target_id": "{{targetId}}",
                    "work_type": "{{type}}",
                    "pixiv_id": "{{pixivId}}",
                    "source_label": "PixivFlow · {{slotName}}",
                    "source_ref": "{{executionId}}",
                    "scheduled_at": "{{occurrenceAt}}",
                    "refetch_request_id": "{{refetchRequestId}}"
                },
                "maxAttempts": 3,
                "retryDelayMs": 3000,
                "scheduleOutcomeUrl": "${TELEPOST_API_BASE_URL}/api/bot2/v1/schedule/outcomes"
            }
        }
    },
    "targets": [
        {
            "id": "bot1-illust-topic-a",
            "type": "illustration",
            "mode": "topic",
            "limit": 1,
            "storageMode": "cache",
            "delivery": {
                "target": "bot1-submit"
            },
            "topic": "テーマ甲",
            "date": "YESTERDAY",
            "topicDiscovery": {
                "includeR18": true,
                "relatedTags": "when_seed_insufficient",
                "tagRelations": {
                    "deny": ["主题乙", "テーマ乙", "テーマ乙別名", "topic-beta"]
                }
            },
            "excludeAI": true,
            "aiMetadataCheck": true,
            "maxPageCount": 30,
            "noMatchPolicy": {
                "lookbackDays": 3,
                "notify": false
            },
            "topicProfile": {
                "primary": [
                    "テーマ甲"
                ],
                "related": [],
                "strategy": {
                    "freshnessWeight": 0.4,
                    "popularityWeight": 0.3
                },
                "inventory": {
                    "enabled": true,
                    "maxAgeDays": 30,
                    "reserveSize": 20,
                    "fallback": true
                }
            }
        },
        {
            "id": "bot1-novel-topic-a",
            "type": "novel",
            "mode": "topic",
            "limit": 1,
            "storageMode": "cache",
            "delivery": {
                "target": "bot1-submit",
                "richNovelPreview": {
                    "url": "http://telepress-publish.flycast/publish/rich-novel",
                    "headers": {
                        "Authorization": "Bearer ${TELEPRESS_API_KEY}"
                    },
                    "field": "novel_preview_url"
                }
            },
            "topic": "テーマ甲",
            "date": "YESTERDAY",
            "topicDiscovery": {
                "includeR18": true,
                "relatedTags": "when_seed_insufficient",
                "tagRelations": {
                    "deny": ["主题乙", "テーマ乙", "テーマ乙別名", "topic-beta"]
                }
            },
            "languageFilter": "chinese",
            "languageCandidateLimit": 20,
            "strictLanguageFilter": true,
            "noMatchPolicy": {
                "lookbackDays": 3,
                "notify": false
            },
            "topicProfile": {
                "primary": [
                    "テーマ甲"
                ],
                "related": [],
                "strategy": {
                    "freshnessWeight": 0.4,
                    "popularityWeight": 0.3
                },
                "inventory": {
                    "enabled": true,
                    "maxAgeDays": 30,
                    "reserveSize": 20,
                    "fallback": true
                }
            }
        },
        {
            "id": "bot2-illust-topic-b",
            "type": "illustration",
            "mode": "topic",
            "limit": 1,
            "storageMode": "cache",
            "delivery": {
                "target": "bot2-submit"
            },
            "topic": "テーマ乙",
            "date": "YESTERDAY",
            "topicDiscovery": {
                "includeR18": true,
                "relatedTags": "when_seed_insufficient",
                "tagRelations": {
                    "deny": ["テーマ甲", "テーマ甲別名", "テーマ甲関連", "主题甲相关", "主题甲", "topic-alpha"]
                }
            },
            "excludeAI": true,
            "aiMetadataCheck": true,
            "maxPageCount": 30,
            "noMatchPolicy": {
                "lookbackDays": 3,
                "notify": false
            },
            "topicProfile": {
                "primary": [
                    "テーマ乙"
                ],
                "related": [],
                "strategy": {
                    "freshnessWeight": 0.4,
                    "popularityWeight": 0.3
                },
                "inventory": {
                    "enabled": true,
                    "maxAgeDays": 30,
                    "reserveSize": 20,
                    "fallback": true
                }
            }
        },
        {
            "id": "bot2-novel-topic-b",
            "type": "novel",
            "mode": "topic",
            "limit": 1,
            "storageMode": "cache",
            "delivery": {
                "target": "bot2-submit",
                "richNovelPreview": {
                    "url": "http://telepress-publish.flycast/publish/rich-novel",
                    "headers": {
                        "Authorization": "Bearer ${TELEPRESS_API_KEY}"
                    },
                    "field": "novel_preview_url"
                }
            },
            "topic": "テーマ乙",
            "date": "YESTERDAY",
            "topicDiscovery": {
                "includeR18": true,
                "relatedTags": "when_seed_insufficient",
                "tagRelations": {
                    "deny": ["テーマ甲", "テーマ甲別名", "テーマ甲関連", "主题甲相关", "主题甲", "topic-alpha"]
                }
            },
            "languageFilter": "chinese",
            "languageCandidateLimit": 20,
            "strictLanguageFilter": true,
            "noMatchPolicy": {
                "lookbackDays": 3,
                "notify": false
            },
            "topicProfile": {
                "primary": [
                    "テーマ乙"
                ],
                "related": [],
                "strategy": {
                    "freshnessWeight": 0.4,
                    "popularityWeight": 0.3
                },
                "inventory": {
                    "enabled": true,
                    "maxAgeDays": 30,
                    "reserveSize": 20,
                    "fallback": true
                }
            }
        }
    ],
    "initialDelay": 0
}
