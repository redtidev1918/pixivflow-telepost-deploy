{
  "logLevel": "info",
  "pixiv": {
    "clientId": "MOBrBDS8blbauoSck0ZfDbtuzpyT",
    "clientSecret": "lsACyCD94FhDUtGTXi3QzcFE2uU1hqtDaKeqrdwj",
    "deviceToken": "pixiv",
    "refreshToken": "YOUR_REFRESH_TOKEN",
    "userAgent": "PixivAndroidApp/5.0.234 (Android 11; Pixel 6)"
  },
  "network": {
    "timeoutMs": 30000,
    "retries": 3,
    "retryDelay": 2000
  },
  "storage": {
    "databasePath": "./pixivflow.db",
    "downloadDirectory": "./cache",
    "illustrationDirectory": "./cache/illustrations",
    "novelDirectory": "./cache/novels",
    "cacheRetentionDays": 7,
    "cacheMaxSizeMB": 384
  },
  "scheduler": {
    "enabled": false,
    "cron": "0 3 * * *",
    "timezone": "Asia/Shanghai"
  },
  "schedules": [
    {
      "id": "bot1-daily",
      "name": "Bot1 每日 10:00 & 18:00 主题示例A 插画 + 小说",
      "enabled": false,
      "cron": "0 10,18 * * *",
      "timezone": "Asia/Shanghai",
      "targetIds": [
        "bot1-illust-topic-a",
        "bot1-novel-topic-a"
      ],
      "timeout": 1800000,
      "maxConsecutiveFailures": 5,
      "failureRetryDelay": 30000
    },
    {
      "id": "bot2-daily",
      "name": "Bot2 每日 10:10 & 18:10 主题示例B 插画 + 小说",
      "enabled": false,
      "cron": "10 10,18 * * *",
      "timezone": "Asia/Shanghai",
      "targetIds": [
        "bot2-illust-topic-b",
        "bot2-novel-topic-b"
      ],
      "timeout": 1800000,
      "maxConsecutiveFailures": 5,
      "failureRetryDelay": 30000
    }
  ],
  "schedulerRuntime": {
    "watchConfig": true,
    "reloadDebounceMs": 500,
    "queueLimit": 2
  },
  "download": {
    "concurrency": 1,
    "requestDelay": 1000,
    "dynamicConcurrency": false,
    "minConcurrency": 1,
    "maxRetries": 3,
    "retryDelay": 3000,
    "timeout": 90000
  },
  "delivery": {
    "targets": {
      "telepost-bot1": {
        "type": "httpMultipart",
        "url": "${TELEPOST_API_BASE_URL}/api/bot1/v1/submissions",
        "notificationUrl": "${TELEPOST_API_BASE_URL}/api/bot1/v1/notifications",
        "headers": {
          "Authorization": "Bearer ${TELEPOST_BOT1_SUBMIT_TOKEN}"
        },
        "fileField": "files",
        "fields": {
          "title": "{{title}}",
          "tags": [
            "Pixiv",
            "{{topicTag}}",
            "{{xRestrictTag}}",
            "{{workTags}}"
          ],
          "note": "Pixiv 每日热榜自动投稿\n📅 热门日期：{{rankingDate}}\n⭐ 收藏：{{bookmarkCount}} · 👁 浏览：{{viewCount}}\n🕒 作品发布于：{{publishedDate}}\n🛡️ Pixiv 分级：{{xRestrictLabel}}（x_restrict={{xRestrict}}）\n主题：{{topicTag}} · 作品ID：{{pixivId}}",
          "link": "{{link}}",
          "target_id": "{{targetId}}",
          "anonymous": true,
          "spoiler": false,
          "idempotency_key": "pixiv:bot1:{{type}}:{{pixivId}}"
        },
        "success": {
          "statuses": [
            201
          ],
          "jsonPath": "ok",
          "equals": true
        },
        "maxAttempts": 3,
        "retryDelayMs": 3000
      },
      "telepost-bot2": {
        "type": "httpMultipart",
        "url": "${TELEPOST_API_BASE_URL}/api/bot2/v1/submissions",
        "notificationUrl": "${TELEPOST_API_BASE_URL}/api/bot2/v1/notifications",
        "headers": {
          "Authorization": "Bearer ${TELEPOST_BOT2_SUBMIT_TOKEN}"
        },
        "fileField": "files",
        "fields": {
          "title": "{{title}}",
          "tags": [
            "Pixiv",
            "{{topicTag}}",
            "{{xRestrictTag}}",
            "{{workTags}}"
          ],
          "note": "Pixiv 每日热榜自动投稿\n📅 热门日期：{{rankingDate}}\n⭐ 收藏：{{bookmarkCount}} · 👁 浏览：{{viewCount}}\n🕒 作品发布于：{{publishedDate}}\n🛡️ Pixiv 分级：{{xRestrictLabel}}（x_restrict={{xRestrict}}）\n主题：{{topicTag}} · 作品ID：{{pixivId}}",
          "link": "{{link}}",
          "target_id": "{{targetId}}",
          "anonymous": true,
          "spoiler": false,
          "idempotency_key": "pixiv:bot2:{{type}}:{{pixivId}}"
        },
        "success": {
          "statuses": [
            201
          ],
          "jsonPath": "ok",
          "equals": true
        },
        "maxAttempts": 3,
        "retryDelayMs": 3000
      }
    },
    "deleteAfterDelivery": false
  },
  "targets": [
    {
      "id": "bot1-illust-topic-a",
      "type": "illustration",
      "mode": "topic",
      "topic": "ミク",
      "date": "YESTERDAY",
      "topicDiscovery": {
        "includeR18": false
      },
      "excludeAI": true,
      "limit": 1,
      "storageMode": "cache",
      "delivery": {
        "target": "telepost-bot1"
      },
      "aiMetadataCheck": true,
      "maxPageCount": 30
    },
    {
      "id": "bot1-novel-topic-a",
      "type": "novel",
      "mode": "topic",
      "topic": "ミク",
      "date": "YESTERDAY",
      "topicDiscovery": {
        "includeR18": false
      },
      "languageFilter": "chinese",
      "languageCandidateLimit": 20,
      "strictLanguageFilter": true,
      "noMatchPolicy": {
        "lookbackDays": 3,
        "notify": true
      },
      "limit": 1,
      "storageMode": "cache",
      "delivery": {
        "target": "telepost-bot1"
      }
    },
    {
      "id": "bot2-illust-topic-b",
      "type": "illustration",
      "mode": "topic",
      "topic": "アークナイツ",
      "date": "YESTERDAY",
      "topicDiscovery": {
        "includeR18": false
      },
      "excludeAI": true,
      "limit": 1,
      "storageMode": "cache",
      "delivery": {
        "target": "telepost-bot2"
      },
      "aiMetadataCheck": true,
      "maxPageCount": 30
    },
    {
      "id": "bot2-novel-topic-b",
      "type": "novel",
      "mode": "topic",
      "topic": "アークナイツ",
      "date": "YESTERDAY",
      "topicDiscovery": {
        "includeR18": false
      },
      "languageFilter": "chinese",
      "languageCandidateLimit": 20,
      "strictLanguageFilter": true,
      "noMatchPolicy": {
        "lookbackDays": 3,
        "notify": true
      },
      "limit": 1,
      "storageMode": "cache",
      "delivery": {
        "target": "telepost-bot2"
      }
    }
  ],
  "initialDelay": 0
}