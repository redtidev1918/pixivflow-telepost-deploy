{
  "logLevel": "info",
  "pixiv": {
    "clientId": "MOBrBDS8blbauoSck0ZfDbtuzpyT",
    "clientSecret": "lsACyCD94FhDUtGTXi3QzcFE2uU1hqtDaKeqrdwj",
    "deviceToken": "pixiv",
    "refreshToken": "YOUR_REFRESH_TOKEN",
    "userAgent": "PixivAndroidApp/5.0.234 (Android 11; Pixel 6)"
  },
  "network": {
    "timeoutMs": 30000,
    "retries": 3,
    "retryDelay": 2000
  },
  "storage": {
    "databasePath": "./pixivflow.db",
    "downloadDirectory": "./cache",
    "illustrationDirectory": "./cache/illustrations",
    "novelDirectory": "./cache/novels"
  },
  "scheduler": {
    "enabled": false,
    "cron": "0 3 * * *",
    "timezone": "Asia/Shanghai"
  },
  "schedules": [
    {
      "id": "bot1-daily",
      "name": "Bot1 daily 10:00 ボテ腹 非AI插画 + 中文小说 (NSFW)",
      "enabled": false,
      "cron": "0 10 * * *",
      "timezone": "Asia/Shanghai",
      "targetIds": [
        "bot1-illust-botefuku",
        "bot1-novel-botefuku"
      ],
      "timeout": 1800000,
      "maxConsecutiveFailures": 5,
      "failureRetryDelay": 30000
    },
    {
      "id": "bot2-daily",
      "name": "Bot2 daily 10:00 丸呑み 非AI插画 + 中文小说 (NSFW)",
      "enabled": false,
      "cron": "0 10 * * *",
      "timezone": "Asia/Shanghai",
      "targetIds": [
        "bot2-illust-marunomi",
        "bot2-novel-marunomi"
      ],
      "timeout": 1800000,
      "maxConsecutiveFailures": 5,
      "failureRetryDelay": 30000
    }
  ],
  "schedulerRuntime": {
    "watchConfig": true,
    "reloadDebounceMs": 500,
    "queueLimit": 2
  },
  "download": {
    "concurrency": 1,
    "requestDelay": 1000,
    "dynamicConcurrency": false,
    "minConcurrency": 1,
    "maxRetries": 3,
    "retryDelay": 3000,
    "timeout": 90000
  },
  "delivery": {
    "targets": {
      "telepost-bot1": {
        "type": "httpMultipart",
        "url": "http://127.0.0.1:8080/api/bot1/v1/submissions",
        "headers": {
          "Authorization": "Bearer ${TELEPOST_BOT1_SUBMIT_TOKEN}"
        },
        "fileField": "files",
        "fields": {
          "title": "{{title}}",
          "tags": [
            "Pixiv",
            "{{topicTag}}",
            "{{workTags}}"
          ],
          "note": "Pixiv 每日热榜自动投稿\n主题：{{topicTag}} · 作品ID：{{pixivId}}\n来源：Pixiv 昨日榜 · 经 TelePost 审核发布",
          "link": "{{link}}",
          "anonymous": true,
          "spoiler": "{{spoiler}}",
          "idempotency_key": "pixiv:bot1:{{type}}:{{pixivId}}"
        },
        "success": {
          "statuses": [
            201
          ],
          "jsonPath": "ok",
          "equals": true
        },
        "maxAttempts": 3,
        "retryDelayMs": 3000
      },
      "telepost-bot2": {
        "type": "httpMultipart",
        "url": "http://127.0.0.1:8080/api/bot2/v1/submissions",
        "headers": {
          "Authorization": "Bearer ${TELEPOST_BOT2_SUBMIT_TOKEN}"
        },
        "fileField": "files",
        "fields": {
          "title": "{{title}}",
          "tags": [
            "Pixiv",
            "{{topicTag}}",
            "{{workTags}}"
          ],
          "note": "Pixiv 每日热榜自动投稿\n主题：{{topicTag}} · 作品ID：{{pixivId}}\n来源：Pixiv 昨日榜 · 经 TelePost 审核发布",
          "link": "{{link}}",
          "anonymous": true,
          "spoiler": "{{spoiler}}",
          "idempotency_key": "pixiv:bot2:{{type}}:{{pixivId}}"
        },
        "success": {
          "statuses": [
            201
          ],
          "jsonPath": "ok",
          "equals": true
        },
        "maxAttempts": 3,
        "retryDelayMs": 3000
      }
    },
    "deleteAfterDelivery": true
  },
  "targets": [
    {
      "id": "bot1-illust-botefuku",
      "type": "illustration",
      "mode": "topic",
      "topic": "ボテ腹",
      "date": "YESTERDAY",
      "topicDiscovery": { "includeR18": true },
      "excludeAI": true,
      "limit": 1,
      "storageMode": "cache",
      "delivery": {
        "target": "telepost-bot1"
      }
    },
    {
      "id": "bot1-novel-botefuku",
      "type": "novel",
      "mode": "topic",
      "topic": "ボテ腹",
      "date": "YESTERDAY",
      "topicDiscovery": { "includeR18": true },
      "languageFilter": "chinese",
      "languageCandidateLimit": 20,
      "strictLanguageFilter": true,
      "limit": 1,
      "storageMode": "cache",
      "delivery": {
        "target": "telepost-bot1"
      }
    },
    {
      "id": "bot2-illust-marunomi",
      "type": "illustration",
      "mode": "topic",
      "topic": "丸呑み",
      "date": "YESTERDAY",
      "topicDiscovery": { "includeR18": true },
      "excludeAI": true,
      "limit": 1,
      "storageMode": "cache",
      "delivery": {
        "target": "telepost-bot2"
      }
    },
    {
      "id": "bot2-novel-marunomi",
      "type": "novel",
      "mode": "topic",
      "topic": "丸呑み",
      "date": "YESTERDAY",
      "topicDiscovery": { "includeR18": true },
      "languageFilter": "chinese",
      "languageCandidateLimit": 20,
      "strictLanguageFilter": true,
      "limit": 1,
      "storageMode": "cache",
      "delivery": {
        "target": "telepost-bot2"
      }
    }
  ],
  "initialDelay": 0
}
